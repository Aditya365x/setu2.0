# Copy to .env and fill in. .env is gitignored — never commit real credentials.
#
# Leave SMS_PROVIDER=mock for the offline demo: outbound messages go to an
# in-memory log readable at GET /api/v1/ingest/sms/outbox, with no account,
# no SIM and no internet.
SMS_PROVIDER=mock

# Set SMS_PROVIDER=twilio and fill these to put the identical confirmation
# messages on a real handset. The Auth Token is a live secret: rotate it if it
# is ever pasted anywhere, including a chat window.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# OFFLINE_MODE=false polls the live NDMA SACHET CAP feed instead of fixtures/.
OFFLINE_MODE=true
